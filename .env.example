# ==============================================================================
# Enterprise Multimodal RAG Environment Configuration Template
# (Copy this to .env or set these variables in Render / Cloud dashboard)
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# Primary LLM Provider: "groq"
LLM_PROVIDER=groq

# Groq API Configuration (Fast token streaming, sub-400ms TTFT)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT=10.0

# OpenAI API Keys & Models (Optional secondary fallback)
OPENAI_API_KEY=
ROUTER_MODEL=gpt-4o-mini
GENERATION_MODEL=gpt-4o

# Dense Embedding Provider (FastEmbed CPU/ONNX)
EMBEDDING_PROVIDER=huggingface
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DIM=384

# Qdrant Vector DB Configuration (Qdrant Cloud in Production)
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key
QDRANT_COLLECTION_NAME=rag_multimodal_documents
QDRANT_LOCAL_PATH=./qdrant_local_data

# Cross-Encoder / FlashRank Configuration
RERANKER_MODEL_NAME=ms-marco-TinyBERT-L-2-v2
RERANKER_SCORE_THRESHOLD=0.25
RERANKER_TOP_K=6
